   "source": [
    "\n",
    "\n",
    "$f_{int}=\\frac{F_{CPU}}{N\\left(OCR0+1\\right)}$\n",
    "\n",
    "$OCR0=\\frac{F_{CPU}}{Nf_{int}}-1$\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fadef3aa",
   "metadata": {},
   "outputs": [],
   "source": [
    "F_CPU = 8e6\n",
    "N = 164\n",
    "P = 1024\n",
    "\n",
    "t = 66 # ms per most dim LED\n",
    "T2 = t * 1e-6\n",
    "\n",
    "# Frequency per LED for each brightness level\n",
    "f2 = 1 / (N * T2)\n",
    "f3 = f2 / 2\n",
    "f4 = f3 / 2\n",
    "\n"
   ]
  }
